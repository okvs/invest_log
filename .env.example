BOT_TOKEN=your-telegram-bot-token-here

# Firebase Hosting 대시보드 자동 발행
# FIREBASE_PUBLISH=1 일 때만 변경 시 대시보드를 Hosting에 배포한다.
FIREBASE_PUBLISH=0
# 서비스 계정 키 경로(기본: 프로젝트 루트의 firebase-credentials.json)
# FIREBASE_CREDENTIALS=/abs/path/to/firebase-credentials.json
# Hosting 사이트 ID(기본: invest-log-caf3d)
# FIREBASE_HOSTING_SITE=invest-log-caf3d
